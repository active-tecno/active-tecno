# اكتف اوردر — متغيرات البيئة (كلها اختيارية محلياً)
# وضع التشغيل: production على السيرفر (يوقف البيانات التجريبية ويفعّل صفحة الإعداد الأول /setup)
ACTIVE_TECNO_ENV=
# منفذ السيرفر (افتراضي 3000)
PORT=3000
# مسار قاعدة البيانات (افتراضي data/runtime.db — تُنسخ تلقائياً من data/seed.db عند أول تشغيل)
ACTIVE_TECNO_DB=data/runtime.db
# توكن تحقق ويبهوك واتساب (فقط عند ربط واتساب الرسمي)
WHATSAPP_VERIFY_TOKEN=
